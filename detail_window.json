          {"sensor": "GPU Fan*", "type": "Fan"},
          {"sensor": "GPU Fan*", "type": "Control"}
        ]}
      ]},
      {"device": "motherboard", "values": [
        {"section": "section.fans", "one_row": true, "values": [
          {"sensor": "*Fan*", "type": "Fan"},
          {"sensor": "*Pump*", "type": "Fan"},
          {"sensor": "*Fan*", "type": "Control"},
          {"sensor": "*Pump*", "type": "Control"}
        ]}
      ]}
    ]},
    {"title": "tab.cpu", "groups": [
